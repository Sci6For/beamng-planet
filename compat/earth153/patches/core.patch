+function M.requestPlanetGeocode(owner, id, q, lat, lon)
+  if type(owner) ~= 'string' or owner ~= launch.preview or type(id) ~= 'string' or #id < 1 or #id > 128 then return false end
+  if type(q) ~= 'string' or #q < 3 or #q > 1024 then return false end
