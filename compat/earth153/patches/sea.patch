 -- The tile of the server's set the point is in (the nearest centre if on an edge), or nil.
+local function inside(t, p)
+  local dx, dy = p.x - t.x, p.y - t.y
+  local ux, uy = t.ux or 1, t.uy or 0
+  return math.abs(dx * ux + dy * uy) <= t.width / 2 and
+         math.abs(-dx * uy + dy * ux) <= t.height / 2
+end
+
 local function tileAt(p)
   local best, bd
   for _, t in pairs(want and want.tiles or {}) do
-    if math.abs(p.x - t.x) <= t.size / 2 and math.abs(p.y - t.y) <= t.size / 2 then
+    if inside(t, p) then
       local d = (p.x - t.x) ^ 2 + (p.y - t.y) ^ 2
       if not bd or d < bd then best, bd = t, d end
     end
   end
   return best
+end
+
+local function atan2(y, x)
+  if x > 0 then return math.atan(y / x) end
+  if x < 0 then return math.atan(y / x) + (y >= 0 and math.pi or -math.pi) end
+  return y >= 0 and math.pi / 2 or -math.pi / 2
+end
+
+local function setTileRotation(o, t)
+  -- The old square has no yaw. A shoreline rectangle also keeps its in-plane axes after a rebase.
+  local n = math.sqrt(t.nx * t.nx + t.ny * t.ny)
+  local yaw = atan2(t.uy or 0, t.ux or 1)
+  if n <= 1e-9 and math.abs(yaw) <= 1e-9 then
+    o:setField('rotation', 0, '0 0 1 0')
+    return
+  end
+  local halfTilt = math.asin(math.min(n, 1)) / 2
+  local sx, sy = 0, 0
+  if n > 1e-9 then sx, sy = -t.ny / n * math.sin(halfTilt), t.nx / n * math.sin(halfTilt) end
+  local tw, zs, zc = math.cos(halfTilt), math.sin(yaw / 2), math.cos(yaw / 2)
+  local qx, qy, qz, qw = sx * zc + sy * zs, sy * zc - sx * zs, tw * zs, tw * zc
+  local qn = math.sqrt(qx * qx + qy * qy + qz * qz)
+  if qn > 1e-9 then
+    o:setField('rotation', 0, string.format('%.9f %.9f %.9f %.6f', qx / qn, qy / qn, qz / qn,
+                                           math.deg(2 * atan2(qn, qw))))
+  else
+    o:setField('rotation', 0, '0 0 1 0')
+  end
 end
 
