 local pending = nil    -- { at, keys }: someone else changed the time; manual after MISSION_SETUP_S
 local switched = nil   -- the last switch to manual: { at, keys }

+-- Planet owns a temporary manual-sky lease, separate from the saved mode.
+-- Keep this one bounded slot across extension reloads; clear by launch identity.
+local planetOverride = rawget(_G, 'beamngPlanetSkyOverride')
+function M.setPlanetOverride(id)
+  if type(id) ~= 'string' or #id == 0 or #id > 128 then return false end
+  pending = nil
+  planetOverride = {id=id, active=false}
+  rawset(_G, 'beamngPlanetSkyOverride', planetOverride)
+  return true
+end
+function M.clearPlanetOverride(id)
+  if not planetOverride or id ~= planetOverride.id then return false end
+  pending = nil
+  planetOverride = nil
+  rawset(_G, 'beamngPlanetSkyOverride', nil)
+  timer = RESYNC_S
+  return true
+end
+
