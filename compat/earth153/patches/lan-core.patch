+-- Managed coordinator owns only LAN frame changes; all ordinary rebasing stays intact.
+function M.planetBeginSession(operation,generation)
+  planetSession={operation=operation,generation=generation}
+  st.pending,st.terrainPending,st.rebasing=nil,nil,nil
+  st.resync=false
+  net.planetUseProxy(true)
+end
+function M.planetEndSession()
+  planetSession,planetFrameTxn=nil,nil
+  net.planetUseProxy(false)
+end
+function M.planetPrepareFrame(operation,frame,dynamic)
+  if not planetSession then return false end
+  planetFrameTxn={operation=operation,frame=frame,dynamic=dynamic,serial=launch.serial,prepared=false}
+  return true
+end
+function M.planetCommitFrame(operation,dynamic)
+  local t=planetFrameTxn
+  if not t or t.operation~=operation or t.committed then return false end
+  t.committed=true
+  if dynamic then
+    if not t.prepared or not t.message or not st.anchor then return false end
+    st.pending=nil
+    if not commitAnchor(t.message,'rebase',st.sessionId) then t.errorCode='frameImportFailed';return false end
+  end
+  return true
+end
+function M.planetCollisionCoverage(position,velocity,radius)
+  if not st.active or not serverHealthy() or st.rebasing or not st.anchor or not position then return false end
+  local box=guardBox();if not box then return false end
+  radius=math.max(8,tonumber(radius) or 8)
+  local vx,vy,vz=velocity and velocity[1] or 0,velocity and velocity[2] or 0,velocity and velocity[3] or 0
+  local px,py,pz=position[1],position[2],position[3]
+  local ex,ey,ez=px+vx*.5,py+vy*.5,pz+vz*.5
+  for _,pt in ipairs({{px,py,pz},{ex,ey,ez}}) do
+    if pt[1]-radius<box[1] or pt[2]-radius<box[2] or pt[1]+radius>box[3] or pt[2]+radius>box[4] then return false end
+    -- Verified imported raster extent alone is insufficient: roads/tunnels need actual collision probes.
+    if not castRayStatic then return false end
+    for _,offset in ipairs({{0,0},{-radius,-radius},{-radius,radius},{radius,-radius},{radius,radius}}) do
+      local ray=castRayStatic(vec3(pt[1]+offset[1],pt[2]+offset[2],pt[3]+3),vec3(0,0,-1),15)
+      if type(ray)~='number' or ray~=ray or ray<0 or ray>=15 then return false end
+    end
+  end
+  return true
+end
+function M.planetCurrentFrame()
+  return st.anchor and {lat=st.anchor.lat,lon=st.anchor.lon,serverSession=st.sessionId,anchorId=st.anchorId,commitSerial=launch.serial} or nil
+end
+function M.planetFrameStatus()
+  local t=planetFrameTxn;if not t then return nil end
+  local msg=t.message
+  local b={operation=t.operation,prepared=t.prepared,errorCode=t.errorCode,serverSession=st.sessionId,
+    anchorId=t.dynamic and not t.committed and msg and msg.anchorId or st.anchorId,
+    commitSerial=launch.serial,applied=false}
+  if t.committed and not st.rebasing and st.active and st.anchorSession==st.sessionId then
+    local v=getPlayerVehicle(0);local pos=v and v:getPosition();local vel=v and v:getVelocity()
+    local identity=not t.dynamic or (msg and st.anchorId==msg.anchorId)
+    if identity and pos and vel and not t.errorCode then
+      if t.dynamic and not t.appliedSerial then launch.serial=launch.serial+1;t.appliedSerial=launch.serial end
+      b.commitSerial=launch.serial;b.applied=M.planetCollisionCoverage({pos.x,pos.y,pos.z},{vel.x,vel.y,vel.z},4) end
+  end
+  return b
+end
