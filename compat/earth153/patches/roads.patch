+-- Fixed launch box only: at radius 128 this visits four cells, never the world queues.
+-- Empty payloads are valid; failed/dequeued work is retained as a failure.
+function M.launchReadiness(aid, box)
+  local out = {required=0,ready=0,errors={},collisionSerial=collisionSerial,
+    settled=swapQuiet == nil and updateSerial > rebuiltFrame}
+  if not M.enabled then out.errorCode='roadsDisabled' end
+  if not box then return out end
+  for gx=math.floor(box[1]/M.TILE_M),math.floor(box[3]/M.TILE_M) do
+    for gy=math.floor(box[2]/M.TILE_M),math.floor(box[4]/M.TILE_M) do
+      out.required=out.required+1
+      local key=tileKey(aid,gx..'_'..gy)
+      local t=tiles[key]
+      if launchErrors[key] then out.errors[#out.errors+1]={key=key,error=launchErrors[key]} end
+      local ready=M.enabled and aid ~= nil and aid == anchorId and t and not t.ghost
+        and session ~= nil and t.launchSession == session
+        and not launchErrors[key] and t.launchCompleted == t.launchChunks
+        and (not t.launchRoad or t.road) and out.settled
+      if ready then
+        for what in pairs(t.colWant or {}) do
+          if not t[what] or ((t.colAt and t.colAt[what]) or math.huge) >= lastReloadAt then ready=false end
+        end
+      end
+      if ready then out.ready=out.ready+1 end
+    end
+  end
+  return out
+end
+
